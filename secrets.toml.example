# Copy this file to .streamlit/secrets.toml in your repo (or paste into
# Streamlit Cloud's "Secrets" settings for your app — do NOT commit real
# secrets.toml to a public repo). Every key below is OPTIONAL — the app
# runs fine with none of them filled in, and each feature activates
# automatically the moment its keys are present.

# --- Database (recommended before real users sign up) ---
# Without this, accounts/listings live in a local SQLite file that can be
# wiped on redeploy. Get a free Postgres instance from Supabase or Neon,
# then paste its connection string here, e.g.:
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"
DATABASE_URL = ""

# --- Affiliate programs (this is how the app can earn money on sales) ---
# Get approved for these first, then paste your IDs below.
AMAZON_AFFILIATE_TAG = ""      # Amazon Associates
EBAY_CAMPAIGN_ID = ""          # eBay Partner Network
ALIEXPRESS_AFFILIATE_ID = ""   # AliExpress Affiliate

# --- Stripe (for the "Upgrade to Pro" subscription option) ---
STRIPE_SECRET_KEY = ""   # starts with sk_live_... or sk_test_...
STRIPE_PRICE_ID = ""     # the Price ID for your subscription product
APP_URL = ""              # your deployed app's URL, e.g. https://apex-scraper.streamlit.app
